#!/bin/sh
# awake — ask Maben Awake to keep the Mac awake and wake (unfreeze) apps.
#
#   awake need <app> [minutes]      unfreeze <app> for N minutes (default 10); released when your turn ends
#   awake done <app>                let <app> freeze again
#   awake hold <name> [minutes]     keep the Mac awake for N minutes (default 15)
#   awake release <name>            release a hold
#   awake run <name> -- <cmd...>    keep awake while <cmd> runs
#   awake list                      show active holds
#   awake log [lines]               why Maben Awake kept the Mac awake (or didn't), sleeps and wakes
#   awake sleeplog [lines]          macOS's own record of real sleeps and wakes (pmset log)
#   awake status                    check that everything Maben Awake needs is set up
#   awake hook                      used by agent hooks (reads hook JSON on stdin)
#
# Holds are files in ~/Library/Application Support/MabenAwake/leases/<name>
# containing "<expiry-timestamp> <owner-pid> [app]". Maben Awake.app watches
# that folder and drops a hold once it expires or its owner process exits.
set -e
DIR="${MABEN_AWAKE_LEASES:-$HOME/Library/Application Support/MabenAwake/leases}"
LOG="${MABEN_AWAKE_HOOK_LOG:-$HOME/Library/Logs/MabenAwake-hooks.log}"
mkdir -p "$DIR"

safe() { printf '%s' "$1" | tr -c 'A-Za-z0-9._-' '_'; }
say() { [ -n "$AWAKE_QUIET" ] || echo "awake: $*"; }

# The agent process we're running under (0 if none), so holds die with it.
# Agents installed with npm run as `node <path>/<agent>`.
is_agent() {
    case "$1" in
        *claude*|*codex*|*[Cc]ursor*|*gemini*|*copilot*|*opencode*|*qwen*|*droid*|*devin*|*auggie*|*kiro*) return 0 ;;
    esac
    return 1
}
owner() {
    p=$PPID
    while [ -n "$p" ] && [ "$p" -gt 1 ]; do
        c=$(ps -o comm= -p "$p" 2>/dev/null)
        if is_agent "${c##*/}"; then echo "$p"; return; fi
        case "${c##*/}" in node|bun|deno)
            set -- $(ps -o args= -p "$p" 2>/dev/null)
            if is_agent "$2"; then echo "$p"; return; fi ;;
        esac
        p=$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' ')
    done
    echo 0
}

hold() { # name minutes owner [app]
    echo "$(( $(date +%s) + ${2:-15} * 60 )) ${3:-0}${4:+ $4}" > "$DIR/$(safe "$1")"
}
release() { rm -f "$DIR/$(safe "$1")"; }

need() { # app minutes owner
    hold "need-$(safe "$1")-$3" "${2:-10}" "$3" "$1"
}
release_needs() { # owner
    for f in "$DIR"/need-*-"$1"; do [ -e "$f" ] && rm -f "$f"; done; return 0
}

case "$1" in
    need)
        [ -n "$2" ] || { echo "usage: awake need <app> [minutes]" >&2; exit 1; }
        need "$2" "$3" "$(owner)"; say "'$2' is awake for ${3:-10} min" ;;
    done)
        [ -n "$2" ] || { echo "usage: awake done <app>" >&2; exit 1; }
        for f in "$DIR"/need-"$(safe "$2")"-*; do [ -e "$f" ] && rm -f "$f"; done; say "'$2' may freeze again" ;;
    hold)
        [ -n "$2" ] || { echo "usage: awake hold <name> [minutes]" >&2; exit 1; }
        hold "$2" "${3:-15}" 0; say "holding '$2' for ${3:-15} min" ;;
    release)
        [ -n "$2" ] || { echo "usage: awake release <name>" >&2; exit 1; }
        release "$2"; say "released '$2'" ;;
    run)
        name="$2"; shift 2; [ "$1" = "--" ] && shift
        me=$$
        # Refresh the hold every 5 minutes while the command runs.
        ( while :; do hold "$name" 10 "$me"; sleep 300; done ) & keeper=$!
        trap 'kill $keeper 2>/dev/null; release "$name"' EXIT INT TERM
        "$@" ;;
    list)
        now=$(date +%s)
        for f in "$DIR"/*; do
            [ -f "$f" ] || continue
            read -r exp _ app < "$f"; left=$(( (exp - now) / 60 ))
            [ "$left" -ge 0 ] && echo "$(basename "$f")  ${left} min left${app:+  (app: $app)}"
        done
        # Apps frozen right now (written by the app; the first line is its pid).
        FROZEN="${MABEN_AWAKE_FROZEN:-$(dirname "$DIR")/frozen}"
        if [ -f "$FROZEN" ]; then
            apps=$(grep -v '^pid ' "$FROZEN" | cut -f2 | paste -sd ',' - | sed 's/,/, /g')
            [ -n "$apps" ] && echo "frozen: $apps"
        fi; true ;;
    log)
        EVENTS="$HOME/Library/Logs/MabenAwake.log"
        [ -f "$EVENTS" ] || { echo "awake: no log yet ($EVENTS)" >&2; exit 1; }
        tail -n "${2:-60}" "$EVENTS" ;;
    sleeplog)
        # Real sleeps (lid, idle, low battery…) and user wakes; skips the
        # Power Nap / maintenance dark wakes that happen every few minutes.
        pmset -g log | grep -E " (Sleep|Wake) +	" \
            | grep -vE "Maintenance Sleep|Sleep Service Back to Sleep|Notification Wake Back to Sleep|Entering DarkWake" \
            | sed -E 's/ +\+[0-9]{4} /  /; s/	+/  /g; s/ {3,}/  /g' | cut -c1-160 | tail -n "${2:-30}" ;;
    status)
        # One look at everything that has to be in place, for support questions.
        APP="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")/../.." 2>/dev/null && pwd)"
        ok() { printf '  ok    %s\n' "$*"; }
        warn() { printf '  WARN  %s\n' "$*"; problems=$((problems + 1)); }
        info() { printf '  ..    %s\n' "$*"; }
        problems=0
        version=$(/usr/bin/plutil -extract CFBundleShortVersionString raw "$APP/Contents/Info.plist" 2>/dev/null || echo "?")
        echo "Maben Awake $version  ($APP)"
        case "$APP" in /Applications/*|"$HOME"/Applications/*) ;; *) warn "the app isn't in an Applications folder, so hooks and updates won't work" ;; esac
        if pgrep -xq MabenAwake; then ok "running (pid $(pgrep -x MabenAwake | head -1))"; else warn "not running: open Maben Awake"; fi
        AGENT="$HOME/Library/LaunchAgents/gg.maben.awake.agent.plist"
        if [ -f "$AGENT" ] && launchctl print "gui/$(id -u)/gg.maben.awake.agent" >/dev/null 2>&1; then
            target=$(/usr/libexec/PlistBuddy -c 'Print :ProgramArguments:0' "$AGENT" 2>/dev/null)
            case "$target" in "$APP"/*) ok "starts at login and after a crash" ;; *) warn "the launch agent starts another copy: $target" ;; esac
        else
            warn "doesn't start at login or restart after a crash (Settings > General > Open at login)"
        fi
        HOOK="$APP/Contents/MacOS/maben-awake-hook"
        [ -x "$HOOK" ] || warn "the hook program is missing: $HOOK"
        # Each agent set up on this Mac: <name>|<folder>|<file with the hooks>
        connected=0
        for entry in "Claude Code|.claude|.claude/settings.json" "Codex|.codex|.codex/hooks.json" "Cursor|.cursor|.cursor/hooks.json" \
                     "Gemini CLI|.gemini|.gemini/settings.json" "GitHub Copilot|.copilot|.copilot/hooks/maben-awake.json" \
                     "OpenCode|.config/opencode|.config/opencode/plugins/maben-awake.js" "Qwen Code|.qwen|.qwen/settings.json" \
                     "Droid|.factory|.factory/hooks.json" "Devin|.config/devin|.config/devin/config.json" \
                     "Augment|.augment|.augment/settings.json" "Kiro|.kiro|.kiro/hooks/maben-awake.json"; do
            name=${entry%%|*}; rest=${entry#*|}; folder=${rest%%|*}; file=${rest#*|}
            [ -d "$HOME/$folder" ] || continue
            [ "$name" = Droid ] && [ ! -f "$HOME/$file" ] && file=.factory/settings.json
            if grep -q "$HOOK" "$HOME/$file" 2>/dev/null; then ok "$name connected"; connected=$((connected + 1))
            elif grep -qE "maben-awake-hook|sleepwalker-hook" "$HOME/$file" 2>/dev/null; then warn "$name points at another copy of the app (Settings > Agents > Update)"
            else info "$name is set up on this Mac but not connected (Settings > Agents)"; fi
        done
        # Other Claude Code config folders (CLAUDE_CONFIG_DIR=~/.claude-work…) that have the hooks.
        for file in "$HOME"/.claude-*/settings.json; do
            [ -f "$file" ] || continue
            folder=$(basename "$(dirname "$file")")
            if grep -q "$HOOK" "$file"; then ok "Claude Code connected in ~/$folder"; connected=$((connected + 1))
            elif grep -qE "maben-awake-hook|sleepwalker-hook" "$file"; then warn "Claude Code in ~/$folder points at another copy of the app (Settings > Agents > Update)"; fi
        done
        [ "$connected" -gt 0 ] || warn "no agent is connected, so nothing keeps the Mac awake while an AI works"
        if [ -f /etc/sudoers.d/maben-awake ] || [ -f /etc/sudoers.d/sleepwalker ] || [ -f /etc/sudoers.d/awakekeeper ]; then
            ok "can stay awake with the lid closed"
        else
            info "staying awake with the lid closed isn't set up (Settings > Lid & Power)"
        fi
        FAILSAFE=/Library/PrivilegedHelperTools/gg.maben.awake.failsafe
        if [ -x "$FAILSAFE" ] && [ -f /Library/LaunchDaemons/gg.maben.awake.failsafe.plist ]; then
            have=$("$FAILSAFE" --version 2>/dev/null); want=$("$APP/Contents/MacOS/maben-awake-failsafe" --version 2>/dev/null)
            if [ -z "$want" ] || [ "$have" = "$want" ]; then ok "lid-open failsafe installed"; else warn "lid-open failsafe is version $have, this app has $want (Settings > Lid & Power > Safety)"; fi
        else
            info "lid-open failsafe not installed (Settings > Lid & Power > Safety)"
        fi
        if pmset -g 2>/dev/null | grep -q "SleepDisabled[[:space:]]*1"; then info "closed-lid sleep is blocked right now"; fi
        n=0; for f in "$DIR"/*; do [ -f "$f" ] && n=$((n + 1)); done
        info "$n active request(s), see: awake list"
        if [ "$problems" -eq 0 ]; then echo "Everything is set up."; else echo "$problems problem(s) found."; exit 1; fi ;;
    hook)
        # Agent hooks call the compiled hook directly; this forwards to it.
        FAST="$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")/../MacOS/maben-awake-hook"
        shift
        [ -x "$FAST" ] || { echo "awake: the hook program is missing ($FAST)" >&2; exit 0; }
        exec "$FAST" "$@" ;;
    *) sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
